{
  "name": "@karyl-chan/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-service E2E and recovery gate for the karyl-chan Plugin Platform.",
  "scripts": {
    "build": "tsc",
    "build:required": "node scripts/build-required.mjs",
    "e2e": "pnpm run build:required && node --test \"dist/**/*.e2e.js\"",
    "chaos": "pnpm run build:required && node --test \"dist/**/*.chaos.js\"",
    "test:runner": "node --test scripts/*.test.mjs",
    "required": "pnpm run build:required && pnpm run test:runner && node scripts/run-required.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "typescript": "^6.0.3"
  }
}
